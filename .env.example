# Anthropic API Key for RAG Chatbot
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Upstash Redis — backs the chat endpoint's per-IP rate limiter.
# These two are injected automatically by the Vercel Upstash integration
# (`vercel integration add upstash/upstash-kv`); pull them with `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Fallback names, checked only if the KV_* pair above is absent. Use these if
# pointing at a manually created Upstash instance instead of the integration.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# If neither pair is set, the chat endpoint runs WITHOUT rate limiting
# (fail-open) and logs a warning on every cold start.

# Chat rate limit tuning (both optional).
# Defaults: 15 requests per IP per hour, sliding window.
# Window format: "<number> <unit>" where unit is ms | s | m | h | d (e.g. "30 m").
CHATBOT_RATE_LIMIT_MAX=15
CHATBOT_RATE_LIMIT_WINDOW=1 h
