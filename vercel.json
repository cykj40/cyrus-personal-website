{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "devCommand": "vite",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/resume",
      "destination": "/engineering",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
